<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Roadbook 04 - L'Anello del Delta"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">

  <metadata>
    <name>L'Anello del Delta - Argini, valli e ponti di barche</name>
    <desc>Roadbook 04 v1. Piazza Giorgione (Castelfranco Veneto) - SR308 - Strada dei Vivai - Chioggia - SS309 Romea - Porto Tolle - Polesine Camerini - Sacca di Scardovari - ponte di barche di Santa Giulia - Gorino Veneto - ponte di barche di Gorino - Mesola - SS309 nord - Mestre - Castelfranco. Circa 350 km. Percorso senza data, MAI DI LUNEDI NE DI MARTEDI (ristorante chiuso). DUE VERIFICHE PRIMA DI PARTIRE: 1) i ponti di barche chiudono con la piena del Po, controllare gli avvisi del Parco Regionale Veneto del Delta del Po; 2) con nebbia fitta sugli argini senza parapetto questo giro non si fa. Il pedaggio dei ponti si paga SOLO IN CONTANTI al casotto. Coordinate delle soste verificate su Google Places, agosto 2026.</desc>
  </metadata>

  <!-- ================= SOSTE E PUNTI OPERATIVI ================= -->

  <wpt lat="45.6728257" lon="11.9254171">
    <name>START-END Piazza Giorgione</name>
    <desc>Piazza Giorgione, 31033 Castelfranco Veneto TV. Ritrovo, partenza e chiusura anello. Monete e banconote piccole IN TASCA, non nel bauletto: servono ai due pedaggi.</desc>
    <sym>Flag, Blue</sym><type>Start</type>
  </wpt>

  <wpt lat="44.9471780" lon="12.3140470">
    <name>CARBURANTE - IP Porto Tolle 24h</name>
    <desc>Via Tangenziale Nord, 45018 Porto Tolle RO. Tel 800 987 887. Voto 4,6/5. APERTO 24 ORE, pagamento contactless. Ultimo rifornimento affidabile prima degli argini: nel Delta le stazioni hanno orari spezzati e molte chiudono la domenica. CORREZIONE: alle coordinate del "Q8 Romea Porto Viro" indicate in alcune guide c'e un impianto a METANO, inutile per una moto a benzina.</desc>
    <sym>Gas Station</sym><type>Servizio</type>
  </wpt>

  <wpt lat="44.9306229" lon="12.4878988">
    <name>PRANZO - Ristorante Canarin</name>
    <desc>Via Isonzo 45, 45018 Porto Tolle RO. Tel 339 219 3043. Voto 4,6/5 su oltre 1.800 recensioni. CHIUSO LUNEDI E MARTEDI. Mercoledi, giovedi e domenica SOLO PRANZO 12:00-14:00; venerdi e sabato anche cena. PRENOTAZIONE OBBLIGATORIA: e sempre pieno anche infrasettimanale. Sala su palafitte sopra la laguna. Alternative a Scardovari sulla SP38: Al Fritulin, Marina 70 (aperto dalle 10:00, il piu flessibile), Nonna Rosa.</desc>
    <sym>Restaurant</sym><type>Sosta</type>
  </wpt>

  <!-- ================= I DUE PONTI DI BARCHE ================= -->

  <wpt lat="44.8402309" lon="12.3756464">
    <name>PONTE 1 - Ponte di barche di Santa Giulia</name>
    <desc>Attraversamento del PO DELLA DONZELLA su chiatte galleggianti, territorio di Porto Tolle. PEDAGGIO IN CONTANTI al casotto. Passo d'uomo, assetto perfettamente dritto, nessuna frenata sulle assi: il legno umido ha aderenza minima. Giunzioni metalliche da prendere perpendicolari. La struttura si muove assecondando la corrente. Se la parte levatoia e alzata si attende senza incolonnarsi sul tavolato. CHIUDE CON LA PIENA DEL PO.</desc>
    <sym>Danger Area</sym><type>Attenzione</type>
  </wpt>

  <wpt lat="44.8185000" lon="12.3360000">
    <name>PONTE 2 - Ponte di barche di Gorino</name>
    <desc>Attraversamento del PO DI GORO fra Gorino Veneto (RO, Veneto) e Gorino Ferrarese (FE, Emilia-Romagna). Realizzato nel 1979 e aperto al transito l'anno successivo, poggia su venti chiatte di cemento affiancate. Il pontiere riscuote il pedaggio e manovra la parte levatoia. Gratuito per residenti, pedoni e biciclette. PEDAGGIO IN CONTANTI per i veicoli. Stesse regole di guida del ponte di Santa Giulia. CHIUDE CON LA PIENA DEL PO. Coordinata dell'imbocco: verificare sul navigatore.</desc>
    <sym>Danger Area</sym><type>Attenzione</type>
  </wpt>

  <!-- ================= PUNTI DI INTERESSE ================= -->

  <wpt lat="44.8842508" lon="12.4628200">
    <name>POI - Sacca di Scardovari</name>
    <desc>Bacino lagunare con i casoni dei pescatori su palafitte e i filari dell'allevamento delle cozze DOP. La strada corre a pelo d'acqua, carreggiata stretta, NESSUN GUARDRAIL verso l'acqua, brecciolino e sabbia agli incroci. Andatura 30-50 km/h. In alcuni tratti due mezzi non passano affiancati.</desc>
    <sym>Scenic Area</sym><type>POI</type>
  </wpt>

  <wpt lat="44.8465000" lon="12.4590000">
    <name>POI - Villaggio Barricata e Via delle Valli</name>
    <desc>Il tracciato che separa l'acqua salmastra della laguna da quella dolce degli invasi. Colonie stabili di fenicottero rosa: nidificano, non sono di passaggio. Andatura lenta e COSTANTE - i fenicotteri si spaventano del rumore che cambia, non del rumore. Non fermarsi in carreggiata per fotografare: usare piazzole e slarghi.</desc>
    <sym>Scenic Area</sym><type>POI</type>
  </wpt>

  <wpt lat="44.8080000" lon="12.3450000">
    <name>POI - Bacucco e faro di Goro</name>
    <desc>Punta estrema di Gorino Veneto: spiaggia, dune, faro con la casa del guardiano. La Valle di Gorino e inserita dal 1981 fra le zone umide di importanza internazionale. Al largo, l'Isola dell'Amore, raggiungibile solo via mare. ATTENZIONE: a Bacucco NON C'E NESSUN PONTE - alcune guide lo confondono con Gorino. E un vicolo cieco: si va, si guarda, si torna. Sabbia sull'asfalto negli ultimi tratti. Coordinata indicativa, verificare sul navigatore.</desc>
    <sym>Scenic Area</sym><type>POI</type>
  </wpt>

  <!-- ================= EMERGENZE ================= -->

  <wpt lat="45.6717817" lon="11.9283021">
    <name>SOS - Ospedale San Giacomo Apostolo</name>
    <desc>Via dei Carpani 16, Castelfranco Veneto. Tel 0423 7321. Presidio di base.</desc>
    <sym>Medical Facility</sym><type>Emergenza</type>
  </wpt>

  <wpt lat="45.0480892" lon="12.0550678">
    <name>SOS - Ospedale Civile di Adria</name>
    <desc>Piazzale degli Etruschi 9, 45011 Adria RO. Tel 0426 940111. APERTO 24 ORE. Presidio principale del quadrante Delta. ATTENZIONE: da Scardovari sono oltre 40 km di strade minori. Nel Delta il soccorso non e mai vicino. In caso di chiamata dare le COORDINATE GPS, non il nome della strada: molte strade d'argine non hanno nome. Emergenza unica 112.</desc>
    <sym>Medical Facility</sym><type>Emergenza</type>
  </wpt>

  <!-- ================= ROTTA ================= -->

  <rte>
    <name>Anello del Delta del Po - circa 350 km</name>
    <desc>Si scende da NORD verso SUD in una sola direzione, senza tornare indietro. Il motivo e l'orario del pranzo: il ristorante sta nella parte settentrionale del Delta e chiude la cucina alle 14:00. Chi esplora prima Scardovari, che sta a sud, deve poi risalire e arriva a tavola tardi. VERIFICARE che il navigatore instradi sui due ponti di barche e non li aggiri: molte strade d'argine sono cartografate male o non lo sono affatto.</desc>

    <rtept lat="45.6728257" lon="11.9254171"><name>01 START Piazza Giorgione</name>
      <desc>Partenza 08:00 nell'orario tipo. SR308 Nuova del Santo verso sud.</desc></rtept>
    <rtept lat="45.5400000" lon="11.9300000"><name>02 SR308 Nuova del Santo</name>
      <desc>Scorrimento veloce. Coordinata indicativa di transito.</desc></rtept>
    <rtept lat="45.3100000" lon="12.0200000"><name>03 Strada dei Vivai</name>
      <desc>Il tratto piu piacevole dell'avvicinamento.</desc></rtept>
    <rtept lat="45.2160000" lon="12.2780000"><name>04 Chioggia - innesto SS309 Romea</name>
      <desc>Da qui comincia il tratto da attraversare, non da guidare. Distanze ampie, nessun sorpasso inutile, autovelox.</desc></rtept>
    <rtept lat="44.9471780" lon="12.3140470"><name>05 PIENO - IP Porto Tolle 24h</name>
      <desc>Ultimo rifornimento affidabile prima degli argini.</desc></rtept>
    <rtept lat="44.9306229" lon="12.4878988"><name>06 PRANZO - Canarin</name>
      <desc>Arrivare entro le 12:45. Cucina chiusa alle 14:00. Prenotazione obbligatoria.</desc></rtept>
    <rtept lat="44.8465000" lon="12.4590000"><name>07 Villaggio Barricata e Via delle Valli</name>
      <desc>Zona dei fenicotteri. Andatura lenta e costante.</desc></rtept>
    <rtept lat="44.8842508" lon="12.4628200"><name>08 Sacca di Scardovari</name>
      <desc>Casoni su palafitte e filari delle cozze. Strada a pelo d'acqua senza guardrail.</desc></rtept>
    <rtept lat="44.8402309" lon="12.3756464"><name>09 PONTE Santa Giulia - PEDAGGIO</name>
      <desc>Po della Donzella. Contanti pronti. Passo d'uomo.</desc></rtept>
    <rtept lat="44.8080000" lon="12.3450000"><name>10 Deviazione Bacucco e faro</name>
      <desc>Vicolo cieco facoltativo prima di attraversare a Gorino. Si va, si guarda, si torna.</desc></rtept>
    <rtept lat="44.8185000" lon="12.3360000"><name>11 PONTE Gorino - PEDAGGIO</name>
      <desc>Po di Goro. Si entra in Emilia-Romagna su venti chiatte.</desc></rtept>
    <rtept lat="44.9200000" lon="12.2300000"><name>12 Mesola - rientro sulla Romea</name>
      <desc>Si risale verso nord. Coordinata indicativa.</desc></rtept>
    <rtept lat="45.4900000" lon="12.2300000"><name>13 Mestre - nodo viabilistico</name>
      <desc>L'ora peggiore nel punto peggiore. Se si puo, anticipare.</desc></rtept>
    <rtept lat="45.6728257" lon="11.9254171"><name>14 END Piazza Giorgione</name>
      <desc>Chiusura anello.</desc></rtept>
  </rte>
</gpx>
